name: Update EPGs

on:
  schedule:
    - cron: '0 0 * * *' # Daily schedule (Fixed to standard POSIX format to clear GitHub error)
  push:
    branches: ["main"]
  workflow_dispatch: # Allows manual trigger

permissions:
  contents: write # Required for the bot to commit to the repo
  pages: write    # Required to deploy to epg.goveloz.me
  id-token: write # Required for GitHub Pages deployment

concurrency:
  group: "pages"
  cancel-in-progress: false

jobs:
  generate-commit-deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    timeout-minutes: 300
    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 18

      - name: Install Latest iptv-org/epg
        run: |
          echo "Cloning latest iptv-org/epg tool..."
          git clone --depth 1 https://github.com/iptv-org/epg.git temp-epg
          cd temp-epg
          npm install

      - name: Grab Tata Play
        working-directory: ./temp-epg
        continue-on-error: true
        run: |
          echo "Grabbing Tata Play..."
          npm run grab --- --sites=tataplay.com --lang=en --delay=2000 --maxConnections=1 --output=../tataplay.xml

          gzip -9 -f ../tataplay.xml

      - name: Clean up temporary files
        run: |
          rm -rf temp-epg

      - name: Commit and Push to GitHub
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          
          git add tataplay.xml.gz
          
          if git diff-index --quiet HEAD --; then
            echo "🟢 No changes detected in EPGs. Skipping commit."
          else
            echo "🟡 Changes detected! Committing and pushing..."
            git commit -m "Automated EPG Update: $(date +'%Y-%m-%d')"
            git push
            echo "✅ Push successful!"
          fi

      - name: Setup Pages
        uses: actions/configure-pages@v5

      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: '.'

      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v5
